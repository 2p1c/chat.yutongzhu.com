# Copy to backend/.env and adjust as needed. Defaults match docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatdb
# Number of recent messages kept in the Redis cache window.
CACHE_RECENT_MESSAGES=10
# Agent (minimal-agent-ts). Local debug: PORT=8765 npm run server in that repo.
# Compose agent maps 8765:8001; host uvicorn uses this default.
AGENT_URL=http://localhost:8765
# Local site is nginx :8000; API process is `uvicorn --host 0.0.0.0 --port 8001`.

# Resend email auth (do not commit the real API key).
RESEND_API_KEY=
RESEND_FROM=yutongzhu <noreply@chat.yutongzhu.site>
# Comma-separated allowlist. Empty = any email may request a code.
AUTH_EMAIL_ALLOWLIST=
